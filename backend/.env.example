# AI services (WBS-14.5). Copy this file to backend/.env (Git ignores .env) and change it.
# Run with the file: uv run --locked --env-file .env <command>
# The defaults below are a local Ollama (ADR-0001, ADR-0002). Never commit a real API key.

LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:4b-q4_K_M
LLM_API_KEY=
# 12 s is the requirement (NFR-17). A laptop without a GPU needs more.
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
# "none" turns off Qwen thinking. Leave it empty if the provider does not know the field.
LLM_REASONING_EFFORT=none

# The embedding settings use the LLM address and key unless you set them.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding:0.6b
# 4 s is the requirement (NFR-17).
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSIONS=1024
