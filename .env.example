# Settings for `docker compose` (WBS-14.6). Copy this file to .env; Git ignores .env.
# All values have defaults, so an empty .env also works. Never commit real keys or passwords.

# Database (local only; change the password if your computer is shared)
POSTGRES_DB=synapseitu
POSTGRES_USER=synapseitu
POSTGRES_PASSWORD=synapseitu-local

# Ports on your computer (change one if it is already in use)
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432
MAILPIT_WEB_PORT=8025
OLLAMA_PORT=11434

# AI models (ADR-0001, ADR-0002); see backend/.env.example for all AI settings.
# Ollama on your computer (default):
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Ollama in a container (`docker compose --profile ollama up`):
# LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3.5:4b-q4_K_M
EMBEDDING_MODEL=qwen3-embedding:0.6b
# A laptop without a GPU needs more than the 12 s and 4 s defaults.
LLM_TIMEOUT_SECONDS=90
EMBEDDING_TIMEOUT_SECONDS=30
